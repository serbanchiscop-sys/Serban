# Phase 2 backend (Supabase). Copy to `.env` and fill in your project values.
# Without these, the app runs in offline demo mode (no sign-in gate, sample data).
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: the Anthropic API key is NOT a client variable. It lives only as a
# Supabase secret for the `ai` edge function:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Never put it in this file or anywhere in the app bundle — it would be
# extractable from the shipped app.

# Phase 4 — RevenueCat (subscriptions). These are PUBLIC SDK keys (appl_… /
# goog_…) and are safe in the client. Without them, the paywall uses the mock.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Phase 4 — Stripe (print-shop physical goods). Publishable key is client-safe.
# The Stripe SECRET key + print provider key are Supabase secrets, NOT here:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set PRINT_PROVIDER_KEY=...     # optional (Prodigi/Gelato/…)
VITE_STRIPE_PUBLISHABLE_KEY=

# Photo import — Google Drive (optional). Without it, Drive import runs in demo
# mode; device/iCloud and Files import work without any config.
VITE_GOOGLE_CLIENT_ID=
